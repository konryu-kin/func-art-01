---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: {
      category: post.data.category.id,
      number: post.data.number.toString(),
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const category = await getEntry(post.data.category);
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <article>
    <p>{`(${category.data.field.id},${category.data.level}) ${category.data.title} ${String.fromCodePoint(0x2460 + post.data.number - 1)}`}</p>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
</BaseLayout>